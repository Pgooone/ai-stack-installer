{
  "name": "ai-stack-installer",
  "version": "0.3.0",
  "description": "跨平台 AI Agent 一键安装脚本",
  "private": false,
  "type": "module",
  "bin": {
    "ai-stack": "dist/cli.js"
  },
  "files": [
    "dist",
    "manifest.json",
    "config"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --no-error-on-unmatched-pattern",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  }
}
